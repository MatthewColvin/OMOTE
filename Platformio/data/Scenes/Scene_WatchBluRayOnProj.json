{
  "Type":"Scene",
  // Name to display at top of screen
  "ScreenName":"BluRay on Projector",
  // List of pages to populate tabview
  "Pages": [
    {
      "PageName":"BluRay Player",
      "ShortName":"BD",
      "FileName":"Pages/Page_BluRay.json",
      // keys defined here from this page will overide all other pages within this scene
      "OverrideKeys":["Stop", "Rewind", "Play","FastForward", "Pause", "ChannelUp", "ChannelDown"]
    },
    {
      "PageName":"AV Receiver",
      "ShortName":"Amp",
      "FileName":"Pages/Page_AVReceiver.json",
      "OverrideKeys":["VolUp", "VolDown", "Mute"]
    },
    { 
      "PageName":"Projector",
      "ShortName":"Proj",
      "FileName":"Pages/Page_Projector.json"
    }
  ],
  "StartCommandSequence":[
    {"CommandFile":"Commands/Commands_PanasonicBluRay.json", "Command":"PWR_ON"},
    {"CommandFile":"Commands/Commands_YamahaAmpMain.json",   "Command":"BD_DVD"},
    {"CommandFile":"Commands/Commands_SonyProjector.json",   "Command":"PWR_ON"}
  ],
  // Sequence of actions that will be executed on leaving this scene
  // Note: leaving means long press of Power button or switching to another scene that
  // has a StartActionsSequence defined
  "ExitCommandSequence":[
    {"CommandFile":"Commands/Commands_PanasonicBluRay.json", "Command":"PWR_OFF"},
    {"CommandFile":"Commands/Commands_YamahaAmpMain.json",   "Command":"PWR_OFF"},
    {"CommandFile":"Commands/Commands_SonyProjector.json",   "Command":"PWR_OFF"}
  ]
}
